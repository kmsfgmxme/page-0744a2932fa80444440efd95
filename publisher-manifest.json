r(--wine-deep);margin-bottom:6px}\n.client p{margin:0;font-size:14px;color:var(--ink-soft)}\n.client .tag{font-size:12px;letter-spacing:.14em;color:var(--accent);display:block;margin-bottom:4px}\n\n/* ---------- FAQ：按主题分组 ---------- */\n.faq-group{margin-bottom:26px}\n.faq-group > h3{font-size:15px;letter-spacing:.14em;color:var(--accent);border-bottom:1px dashed var(--line);padding-bottom:8px;margin-bottom:12px}\n.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 22px}\n.faq{border-left:4px solid var(--wine);padding:2px 0 2px 14px}\n.faq h4{font-size:15.5px;margin:0 0 4px;color:var(--wine-deep)}\n.faq p{margin:0;font-size:14.5px;color:var(--ink-soft)}\n\n/* ---------- 底部固定导航 ---------- */\n.docknav{position:fixed;left:0;right:0;bottom:0;background:var(--wine-deep);border-top:2px solid var(--accent);z-index:20}\n.docknav ul{list-style:none;margin:0 auto;padding:0 14px;max-width:1100px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:2px}\n.docknav li{flex:1 1 auto}\n.docknav a{display:block;text-align:center;padding:12px 4px;font-size:13px;letter-spacing:.08em;color:var(--ivory);border-bottom:none;opacity:.82}\n.docknav a:hover{opacity:1;color:var(--ivory);background:rgba(255,255,255,.08)}\n\nfooter.foot{padding:34px 0 18px;border-top:1px solid var(--line);color:var(--ink-soft);font-size:13.5px}\nfooter.foot strong{color:var(--wine-deep)}\n\n@media (max-width:860px){\n  .grid{grid-template-columns:repeat(2,1fr)}\n  .tile.span2{grid-column:span 2}\n  .steps,.clients,.faq-grid{grid-template-columns:1fr}\n  .plan:nth-child(1),.plan:nth-child(2),.plan:nth-child(3){margin-left:0;margin-right:0}\n}\n@media (max-width:480px){\n  .grid{grid-template-columns:1fr}\n  .tile.span2{grid-column:span 1}\n  .hero{padding-top:32px}\n}\n</style><main>\n\n  <header class=\"hero wrap\">\n    <div class=\"hero-head\">\n      <div>\n        <p class=\"kicker\">Piao Miao Xu · 订阅说明</p>\n        <h1>缥缈墟</h1>\n      </div>\n      <p class=\"hero-lede\">这里不写口号，只把三档订阅的边界、使用顺序和常见疑问摊开。像看一块仪表盘那样，先找到你要的数字，再决定要不要往下读。</p>\n    </div>\n\n    <div class=\"grid\">\n      <div class=\"tile\">\n        <span class=\"label\">套餐档位</span>\n        <span class=\"value\">3 档</span>\n        <span class=\"note\">基础版、旗舰版、团队版</span>\n      </div>\n      <div class=\"tile\">\n        <span class=\"label\">月付起价</span>\n        <span class=\"value\">¥15</span>\n        <span class=\"note\">按年付 ¥150/年</span>\n      </div>\n      <div class=\"tile\">\n        <span class=\"label\">同时在线设备</span>\n        <span class=\"value\">3 / 5 / 20</span>\n        <span class=\"note\">随所选档位变化</span>\n      </div>\n      <div class=\"tile dark\">\n        <span class=\"label\">旗舰版月流量</span>\n        <span class=\"value\">300GB</span>\n        <span class=\"note\">¥35/月，年付 ¥350/年</span>\n      </div>\n      <div class=\"tile\">\n        <span class=\"label\">最高档月流量</span>\n        <span class=\"value\">1000GB</span>\n        <span class=\"note\">团队版 ¥85/月，年付 ¥850/年</span>\n      </div>\n      <div class=\"tile span2\">\n        <span class=\"label\">本页解决什么</span>\n        <span class=\"value\">档位差异 · 上手顺序 · 常见疑问</span>\n        <span class=\"note\">往下读，按你自己的判断取用。</span>\n      </div>\n      <div class=\"tile\">\n        <span class=\"label\">计费方式</span>\n        <span class=\"value\">月付 / 年付</span>\n        <span class=\"note\">年付价见各档说明</span>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"how\" class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">一</span>\n      <h2>开始使用之前，先看清楚顺序</h2>\n    </div>\n    <p class=\"sec-intro\">比起一次性罗列功能，缥缈墟更希望你按下面的顺序走一遍：先确定档位，再装客户端，最后才是日常使用。顺序错了，问题往往不是出在服务上，而是出在起点。</p>\n    <div class=\"steps\">\n      <article class=\"step\">\n        <h3>第一步 · 对照自己的用量</h3>\n        <p>先看每月的流量与同时在线的设备数量，再决定档位。台数超了，体验会打折；流量剩很多，则说明所选档位偏大。</p>\n      </article>\n      <article class=\"step\">\n        <h3>第二步 · 选择月付或年付</h3>\n        <p>月付适合先观察一段时间；年付在价格上更省，但应当是在你已经确认自己会持续使用之后的选择。</p>\n      </article>\n      <article class=\"step\">\n        <h3>第三步 · 安装客户端</h3>\n        <p>依据你手里的设备类型选择对应客户端，按客户端内的引导完成配置。配置信息以你账户页面展示的为准。</p>\n      </article>\n      <article class=\"step\">\n        <h3>第四步 · 形成使用习惯</h3>\n        <p>留意每月的流量进度和设备占用，接近上限时再回头看看档位是否需要调整，而不是等到卡住才想起来。</p>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"plans\" class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">二</span>\n      <h2>三档订阅，逐级往上走</h2>\n    </div>\n    <p class=\"sec-intro\">套餐不是越贵越好，而是与你的人数、设备与用量匹配。下面三档从左到右逐级递进，内容与价格如实列出。</p>\n\n    <div class=\"plans\">\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>基础版</h3>\n          <span class=\"price\">¥15 / 月</span>\n        </div>\n        <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n        <ul>\n          <li>每月 100GB 流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>基础流媒体解锁</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>旗舰版</h3>\n          <span class=\"badge\">多数人止步于此</span>\n          <span class=\"price\">¥35 / 月</span>\n        </div>\n        <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n        <ul>\n          <li>每月 300GB 流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点流媒体解锁</li>\n          <li>IPLC 线路的游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>团队版</h3>\n          <span class=\"price\">¥85 / 月</span>\n        </div>\n        <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n        <ul>\n          <li>每月 1000GB 流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"clients\" class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">三</span>\n      <h2>客户端，按设备对号入座</h2>\n    </div>\n    <p class=\"sec-intro\">缥缈墟不预设你用什么设备，只按三类常见环境给出对应说明。具体安装包与配置信息以账户页面提供的内容为准，本页不提供下载地址。</p>\n    <div class=\"clients\">\n      <article class=\"client\">\n        <span class=\"tag\">桌面端</span>\n        <h3>Windows</h3>\n        <p>适合长期开机、多任务并行的使用场景。安装后在配置页填入账户页给出的信息即可开始使用。</p>\n      </article>\n      <article class=\"client\">\n        <span class=\"tag\">桌面端</span>\n        <h3>macOS</h3>\n        <p>面向苹果电脑用户，安装后按同样的方式完成配置。系统权限提示请按安装包内说明处理。</p>\n      </article>\n      <article class=\"client\">\n        <span class=\"tag\">移动端</span>\n        <h3>Android</h3>\n        <p>适合手机与平板随身使用。安装包以账户页提供的渠道为准，配置信息与桌面端共用同一套。</p>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">四</span>\n      <h2>常见问题，按主题归档</h2>\n    </div>\n    <p class=\"sec-intro\">问题按主题分三组：选档、计费、使用。每组都是明确的问题与明确的回答，不做含糊其辞的绕行。</p>\n\n    <div class=\"faq-group\">\n      <h3>关于选档</h3>\n      <div class=\"faq-grid\">\n        <div class=\"faq\">\n          <h4>我应该从哪一档开始？</h4>\n          <p>先数一下你日常需要同时在线的设备台数。三台以内可以先用基础版；超过三台，就要看旗舰版的五台是否够用。</p>\n        </div>\n        <div class=\"faq\">\n          <h4>旗舰版比基础版多的是什么？</h4>\n          <p>流量从 100GB 提到 300GB，在线设备从 3 台提到 5 台，流媒体解锁范围与线路也相应升级，并增加了优先工单支持。</p>\n        </div>\n        <div class=\"faq\">\n          <h4>什么时候才需要考虑团队版？</h4>\n          <p>当设备数量接近或超过二十台，或需要企业定制路由、专属客户经理这类协作向安排时，团队版才显出意义。</p>\n        </div>\n        <div class=\"faq\">\n          <h4>流量用超了会怎样？</h4>\n          <p>各档的流量按自然月计算。接近上限前建议留意进度；如果长期不够用，说明当前档位与你的实际用量不匹配。</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>关于计费</h3>\n      <div class=\"faq-grid\">\n        <div class=\"faq\">\n          <h4>月付和年付差多少？</h4>\n          <p>基础版年付 ¥150，旗舰版 ¥350，团队版 ¥850，均为对应月付价格的十个月，即以年付的名义少付两个月。</p>\n        </div>\n        <div class=\"faq\">\n          <h4>可以先月付再转年付吗？</h4>\n          <p>可以先以月付观察一段时间，确认用量与体验稳定之后，再考虑年付。转档与计费的具体处理方式以你账户页面的说明为准。</p>\n        </div>\n        <div class=\"faq\">\n          <h4>价格会变动吗？</h4>\n          <p>本页展示的是当前公开的三档价格。若日后发生调整，以账户页面实际结算信息为准，本页不承担比价承诺。</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>关于使用</h3>\n      <div class=\"faq-grid\">\n        <div class=\"faq\">\n          <h4>配置信息从哪里获取？</h4>\n          <p>以你账户页面展示的配置信息为准。本页只说明使用方法与顺序，不提供账号、密钥或任何下载地址。</p>\n        </div>\n        <div class=\"faq\">\n          <h4>同一账号能在多台设备上登录吗？</h4>\n          <p>可以，但同时在线数量受所选档位限制：基础版三台、旗舰版五台、团队版二十台，超出后需要先断开其中一台。</p>\n        </div>\n        <div class=\"faq\">\n          <h4>遇到问题怎么反馈？</h4>\n          <p>通过账户页提供的问题反馈入口提交工单。旗舰版与团队版享有优先处理，基础版按常规顺序响应。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <footer class=\"foot wrap\">\n    <p><strong>缥缈墟</strong> · 本页内容围绕订阅档位、使用顺序与常见问题展开，不构成任何性能或兼容性承诺。涉及账号、配置与结算的信息，请以你账户页面显示的内容为准。</p>\n    <p>说明文字与价格均如实列于正文；页面不提供外部下载链接。</p>\n  </footer>\n\n</main>\n\n<nav class=\"docknav\" aria-label=\"页面导航\">\n  <ul>\n    <li><a href=\"#how\">使用顺序</a></li>\n    <li><a href=\"#plans\">订阅方案</a></li>\n    <li><a href=\"#clients\">客户端</a></li>\n    <li><a href=\"#faq\">常见问题</a></li>\n  </ul>\n</nav>",
